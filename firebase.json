{
  "firestore": {
    "database": "(default)",
    "location": "eur3",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "out",
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      {
        "source": "/dental-turizm",
        "destination": "/",
        "type": 302
      },
      {
        "source": "/en/dental-turizm",
        "destination": "/en",
        "type": 302
      },
      {
        "source": "/tr",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/tr/:path*",
        "destination": "/:path",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/opengraph-image",
        "headers": [
          {
            "key": "Content-Type",
            "value": "image/png"
          }
        ]
      }
    ]
  }
}
